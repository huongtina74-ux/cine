{
  "manifestVersion": 5,
  "id": "com.cinefactory.premiere.bridge",
  "name": "CineFactory Premiere Bridge",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8791"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cinefactoryBridgePanel",
      "label": {
        "default": "CineFactory Bridge"
      },
      "minimumSize": {
        "width": 260,
        "height": 120
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 180
      }
    }
  ]
}