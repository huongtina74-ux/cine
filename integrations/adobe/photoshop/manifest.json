{
  "manifestVersion": 5,
  "id": "com.cinefactory.photoshop.bridge",
  "name": "CineFactory Photoshop Bridge",
  "version": "1.0.0",
  "main": "index.html",
  "host": {"app": "PS", "minVersion": "25.0.0"},
  "requiredPermissions": {
    "network": {"domains": ["http://127.0.0.1:8791"]},
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [{
    "type": "panel",
    "id": "cinefactoryPhotoshopBridgePanel",
    "label": {"default": "CineFactory Bridge"},
    "minimumSize": {"width": 260, "height": 120},
    "preferredDockedSize": {"width": 320, "height": 180}
  }]
}
