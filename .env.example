# CineFactory never requires generation SaaS keys.
# Keep production generation local/LAN.
CINEFACTORY_ENV=production
CINEFACTORY_COMFYUI=http://127.0.0.1:8188
# Optional: command bridge to your own OpenClaw/Codex wrapper.
# It must read JSON on stdin and emit schema-valid JSON on stdout.
CINEFACTORY_REASONING_COMMAND=
